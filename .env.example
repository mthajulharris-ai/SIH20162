# =====================================================================
# SIH 2026 Problem Statement PS 26162
# AI-Based Detection and Classification of Industrial Fires & Persistent Thermal Sources
# Environment Configuration
# =====================================================================

# Project Metadata
PROJECT_NAME="SIH 2026 Thermal Detection API"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

# API Routing
API_V1_STR="/api/v1"

# Database Configuration (SQLite for local prototype, PostgreSQL/PostGIS for production)
DATABASE_URL="sqlite:///./thermal_detections.db"

# CORS Configuration (allowed origins for React GIS dashboard)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# NASA FIRMS API Map Key (optional for live NASA FIRMS API ingestion)
# Obtain a free key from: https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=""
